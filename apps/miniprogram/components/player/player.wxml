<view class="overlay" wx:if="{{visible}}">
  <view class="topbar">
    <text class="plan-summary">{{planSummary}}</text>
  </view>

  <view class="stage">
    <!-- 小熊猫 Canvas 2D 舞台全程保持挂载，确保 prep / breath / done 无缝阻尼过渡 -->
    <view class="panda-wrap {{stage === 'done' ? 'is-done' : ''}}">
      <canvas type="2d" id="pandaCanvas" class="panda-canvas"></canvas>
    </view>

    <block wx:if="{{stage === 'prep'}}">
      <view class="phase-pill">{{phaseText}}</view>
      <view class="prep-num num">{{prepN}}</view>
      <view class="hint prep-hint">{{cueText}}</view>
    </block>

    <block wx:elif="{{stage === 'breath'}}">
      <view class="readout-row">
        <view class="phase-pill {{paused ? 'is-paused' : (phase === 'contract' ? 'is-contract' : 'is-relax')}}">{{phaseText}}</view>
        <view class="count-row">
          <text class="count num {{phase === 'contract' ? 'is-contract' : 'is-relax'}} {{paused ? 'is-dim' : ''}}">{{paused ? '—' : remaining}}</text>
          <text class="count-unit" wx:if="{{!paused}}">秒</text>
        </view>
      </view>
      <view class="cue-text">{{cueText}}</view>
      <view class="hint">{{progressText}}</view>
    </block>

    <block wx:else>
      <view class="done-title">今天，提了。</view>
      <view class="hint">{{doneSub}}</view>
      <view class="done-summary" wx:if="{{doneSummary}}">{{doneSummary}}</view>
    </block>
  </view>

  <view class="controls">
    <block wx:if="{{stage === 'breath'}}">
      <view class="ctrl {{paused ? 'is-primary' : 'is-soft'}}" bindtap="onTogglePause">{{paused ? '继续训练' : '暂停'}}</view>
      <view class="ctrl is-weak" bindtap="onEnd">结束</view>
    </block>
    <block wx:elif="{{stage === 'prep'}}">
      <view class="ctrl" bindtap="onEnd">取消</view>
    </block>
    <block wx:else>
      <view class="ctrl" bindtap="onShare">分享这次</view>
      <view class="ctrl is-primary" bindtap="onDoneOk">返回今日</view>
    </block>
  </view>
</view>
