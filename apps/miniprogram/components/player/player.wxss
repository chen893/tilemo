.overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  flex-direction: column;
  background: var(--paper);
  color: var(--text);
}

.topbar {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 64rpx 48rpx 0;
}

.plan-summary {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-2);
}

.stage {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
}

.eyebrow {
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  color: var(--text-2);
}

.prep-num {
  margin-top: 32rpx;
  font-size: 192rpx;
  line-height: 1.05;
  font-weight: 700;
  color: var(--accent);
}

.prep-meta {
  margin-top: 40rpx;
  padding: 14rpx 32rpx;
  border-radius: 40rpx;
  border: 2rpx solid var(--rule);
  background: var(--paper-soft);
  font-size: 24rpx;
  color: var(--text-2);
}

.pause-pill {
  min-height: 56rpx;
  margin-bottom: 32rpx;
  padding: 10rpx 32rpx;
  border-radius: 40rpx;
  border: 2rpx solid transparent;
  font-size: 26rpx;
  font-weight: 700;
  color: transparent;
  box-sizing: border-box;
}

.pause-pill.is-show {
  border-color: var(--rule-strong);
  background: var(--paper-soft);
  color: var(--text);
}

.panda-wrap {
  width: 480rpx;
  height: 480rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.panda-wrap.is-done {
  width: 380rpx;
  height: 380rpx;
}

.panda-canvas {
  width: 100%;
  height: 100%;
}

.readout-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  margin-top: 24rpx;
}

.phase-pill {
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  background: var(--paper-soft);
  color: var(--text);
  border: 2rpx solid var(--rule-strong);
}

.phase-pill.is-contract {
  background: var(--accent-btn);
  color: var(--on-accent-btn);
  border-color: transparent;
}

.phase-pill.is-relax {
  background: var(--relax);
  color: var(--on-accent-btn);
  border-color: transparent;
}

.phase-pill.is-paused {
  background: var(--paper-soft);
  color: var(--text);
  border-color: var(--rule-strong);
}

.cue-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: var(--text-2);
  text-align: center;
  line-height: 1.5;
}

.count-row {
  display: flex;
  align-items: baseline;
}

.count {
  font-size: 96rpx;
  font-weight: 700;
  line-height: 1;
  color: var(--accent);
}

.count.is-relax {
  color: var(--relax);
}

.count.is-dim {
  color: var(--text-2);
}

.count-unit {
  margin-left: 8rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-3);
}

.hint {
  margin-top: 28rpx;
  font-size: 30rpx;
  color: var(--text-2);
  text-align: center;
}

.prep-hint {
  margin-top: 36rpx;
}

.done-badge {
  padding: 10rpx 32rpx;
  border-radius: 40rpx;
  background: var(--relax-soft);
  color: var(--relax);
  font-size: 28rpx;
  font-weight: 700;
}

.done-title {
  margin-top: 24rpx;
  font-size: 80rpx;
  font-weight: 700;
  color: var(--text);
}

.done-summary {
  margin-top: 40rpx;
  padding: 20rpx 40rpx;
  border-radius: 28rpx;
  border: 2rpx solid var(--rule);
  background: var(--paper-soft);
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.controls {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 32rpx 48rpx 128rpx;
  border-top: 2rpx solid var(--rule);
}

.ctrl {
  min-width: 248rpx;
  height: 92rpx;
  padding: 0 44rpx;
  border-radius: 46rpx;
  border: 2rpx solid var(--rule-strong);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  box-sizing: border-box;
  transition: transform 0.12s ease, opacity 0.12s ease;
}

.ctrl + .ctrl {
  margin-left: 28rpx;
}

.ctrl.is-soft {
  background: var(--paper-soft);
  border-color: var(--rule-strong);
  color: var(--text);
  font-weight: 700;
}

.ctrl.is-primary {
  background: var(--accent-btn);
  border-color: var(--accent-btn);
  color: var(--on-accent-btn);
  font-weight: 700;
}

.ctrl.is-weak {
  min-width: 160rpx;
  border-color: transparent;
  background: transparent;
  color: var(--text-3);
}

.ctrl:active {
  opacity: 0.85;
  transform: scale(0.98);
}
