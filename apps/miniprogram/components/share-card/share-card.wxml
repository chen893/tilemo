<view class="mask" wx:if="{{show}}" catchtap="onTapClose">
  <view class="panel" catchtap="noop">
    <view class="head">
      <text class="head-title">{{title}}</text>
      <view class="head-close" bindtap="onTapClose">×</view>
    </view>

    <scroll-view scroll-y class="preview">
      <canvas type="2d" id="card" class="card-canvas"></canvas>
    </scroll-view>

    <view class="actions">
      <button class="act is-primary" bindtap="onSave" disabled="{{busy || !readyVersion}}">{{busy ? '保存中…' : '保存到相册'}}</button>
      <button class="act is-ghost" open-type="share" data-card-version="{{readyVersion}}" disabled="{{!readyVersion}}">转发给朋友</button>
    </view>
  </view>
</view>
